{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    // lint-staged is invoked from .githooks/pre-commit, which is outside knip's dependency-graph scope
    "lint-staged",
    // The semantic-release plugins and the conventionalcommits preset are
    // resolved by string name at runtime from release.config.mjs, so they
    // appear unreferenced. All are required; dropping any one breaks releases.
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/github",
    "conventional-changelog-conventionalcommits",
  ],
  // `dot` (Graphviz) is a system tool used by the depcruise:graph script,
  // not a package-provided binary.
  "ignoreBinaries": ["dot"],
}
