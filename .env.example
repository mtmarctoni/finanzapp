# Neon connection strings (use --pooler suffix for pooled connections)
POSTGRES_URL=postgresql://user:password@ep-example-pooler.c-8.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-8.us-east-1.aws.neon.tech/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@ep-example.c-8.us-east-1.aws.neon.tech/dbname?sslmode=require

## Next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# GitHub OAuth (Development)
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# Authorization
# Comma-separated identities: GitHub OAuth matches the GitHub login;
# Credentials matches the JSON `name` value, not the email or id.
# Empty / unset = nobody can sign in, with either provider.
ALLOWED_USERS=username1,username2,username3

# Public API
# Create keys through the app and send them as X-API-Key or Authorization: Bearer <key>
#
# API_KEY_PEPPER: high-entropy random string mixed into API key hashes via
# HMAC-SHA-256. Must be set in production. Treat as a long-lived secret —
# rotating it invalidates every existing API key.
API_KEY_PEPPER=

# Development / Vercel Preview Credentials provider
# Enabled only when (NODE_ENV !== 'production' || VERCEL_ENV === 'preview')
# && DEV_CREDENTIALS. This allows configured local non-production runs and
# Vercel Preview deployments, including production-mode Preview builds.
# Local next build / next start without VERCEL_ENV='preview' cannot use it.
# Production deployments (NODE_ENV='production', VERCEL_ENV='production')
# disable Credentials; production sign-in is GitHub OAuth only.
# Keep DEV_CREDENTIALS server-side, out of public/client configuration and
# Vercel Production configuration; configure it only for development/Preview.
# JSON array of objects with string id, email, password, and name fields.
# Placeholder example (replace with your own demo/test values):
# DEV_CREDENTIALS='[{"id":"demo-user-id","email":"demo@example.com","password":"replace-with-demo-password","name":"Demo User"}]'
# Include the exact name in ALLOWED_USERS (for this example: Demo User).
# Point the database connection strings above at the intended demo/test DB
# and use that demo/test user's database id and email to associate their data.
DEV_CREDENTIALS=

# Upstash Redis for persistent rate limiting (recommended for production)
# Get URL and token at https://console.upstash.com
# Falls back to in-memory rate limiting when not configured
#
# Custom names:
#   UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN
#
# Vercel Integration auto-creates these (also detected):
#   KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# AI Provider selection - 'groq' (default), 'openrouter', or 'opencode'
# - groq: Fast, free tier available at https://console.groq.com
# - openrouter: Multiple free models at https://openrouter.ai
# - opencode: Free Big Pickle and paid Kimi 2.5 models at https://opencode.ai
AI_PROVIDER=groq

# Groq - free tier, production-ready. Get key at https://console.groq.com
GROQ_API_KEY=gsk_your-key-here

# OpenRouter - free models available. Get key at https://openrouter.ai/keys
# Only required if AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Opencode Zen - OpenAI-compatible API
# Free tier: Big Pickle model (good for everyday tasks)
# Paid tier: Kimi 2.5 model (high-performance for complex analysis)
# Get key at https://opencode.ai
# Only required if AI_PROVIDER=opencode
OPENCODE_API_KEY=sk-opencode-your-key-here

# CoinGecko (crypto overview prices)
# Optional free demo key from https://www.coingecko.com/en/api/pricing.
# Without a key the public endpoint is used at lower rate limits; prices
# are cached in the crypto_prices table for 5 minutes either way.
COINGECKO_API_KEY=
