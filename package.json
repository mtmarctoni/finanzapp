{
  "name": "finanzapp",
  "version": "0.0.0-development",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise --config .dependency-cruiser.js .",
    "depcruise:graph": "depcruise --config .dependency-cruiser.js . --output-type dot | dot -T svg > dependency-graph.svg",
    "check": "run-p typecheck lint depcruise format:check",
    "check:all": "run-s format lint:fix check knip test audit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "node --test scripts/ci/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:dev": "tsx scripts/seed-db.ts",
    "reset:test": "tsx scripts/reset-test-user-data.ts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "audit": "pnpm audit --audit-level=critical",
    "audit:high": "pnpm audit --audit-level=high",
    "audit:all": "pnpm audit",
    "knip": "knip"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.79",
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@ai-sdk/react": "^3.0.317",
    "@hookform/resolvers": "^5.9.2",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/postgres": "^0.10.0",
    "ai": "^6.0.314",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.4",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^9.5.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "9.23.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
